{
  "name": "nodejs-basics",
  "version": "0.0.1",
  "description": "Cloneable NestJS template: config, logger, telemetry, db, cache, kafka, jobs, idempotency, resilient HTTP client.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start:dev": "pnpm --filter @base/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project unit",
    "check": "pnpm -r check",
    "clean": "pnpm -r clean",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "cov:unit": "node scripts/cover.mjs unit",
    "cov:integration": "node scripts/cover.mjs integration",
    "cov:e2e": "node scripts/cover.mjs e2e",
    "cov:check": "node scripts/cover.mjs merge",
    "allure:report": "scripts/allure-meta.sh allure-results && allure generate --clean --single-file -o allure-report allure-results"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.11",
    "allure-commandline": "2.43.0",
    "allure-vitest": "3.12.1",
    "c8": "12.0.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
