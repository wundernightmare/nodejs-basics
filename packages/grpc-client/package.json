{
  "name": "@base/grpc-client",
  "version": "0.0.1",
  "private": true,
  "description": "Outbound gRPC wiring per target: @grpc/grpc-js service config (deadline, retries, throttling, balancing) + opossum breaker, metrics and tracing.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint --max-warnings=0 src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean:build": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@opentelemetry/api": "1.9.1",
    "opossum": "10.0.0"
  },
  "devDependencies": {
    "@base/testing": "workspace:*",
    "@types/opossum": "8.1.9"
  }
}
