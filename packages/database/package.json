{
  "name": "@base/database",
  "version": "0.0.1",
  "private": true,
  "description": "PostgreSQL pool with TLS, multi-host failover, secret rotation, circuit breaker, per-tenant rate limiter, and AsyncLocalStorage transaction context.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/config": "workspace:*",
    "@base/logger": "workspace:*",
    "@base/resilience": "workspace:*",
    "pg": "8.20.0"
  },
  "peerDependencies": {
    "@nestjs/common": "11.x",
    "@nestjs/config": "4.x"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
