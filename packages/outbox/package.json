{
  "name": "@base/outbox",
  "version": "0.0.1",
  "private": true,
  "description": "Transactional outbox: events written in the same Postgres transaction as the state change, relayed to Kafka at least once, the request trace continued.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint --max-warnings=0 src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean:build": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/common": "workspace:*",
    "@base/config": "workspace:*",
    "@base/database": "workspace:*",
    "@base/kafka": "workspace:*",
    "@base/logger": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "pg": "8.23.0"
  },
  "peerDependencies": {
    "@nestjs/common": "12.x",
    "@nestjs/config": "12.x"
  },
  "devDependencies": {
    "@base/testing": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
