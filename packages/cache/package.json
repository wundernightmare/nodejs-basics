{
  "name": "@base/cache",
  "version": "0.0.1",
  "private": true,
  "description": "Valkey/Redis NestJS module with circuit breaker, OTel metrics, and config builder for both regular + BullMQ clients.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/resilience": "workspace:*",
    "@base/resilient-client": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "iovalkey": "0.4.0"
  },
  "peerDependencies": {
    "@nestjs/common": "12.x",
    "@nestjs/config": "12.x"
  }
}
