{
  "name": "@base/kafka",
  "version": "0.0.1",
  "private": true,
  "description": "Kafka NestJS module with shared producer, librdkafka SASL/TLS config builder, and OTel client metrics.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/logger": "workspace:*",
    "@confluentinc/kafka-javascript": "1.9.0",
    "@opentelemetry/api": "1.9.1"
  },
  "peerDependencies": {
    "@nestjs/common": "11.x",
    "@nestjs/config": "4.x"
  }
}
