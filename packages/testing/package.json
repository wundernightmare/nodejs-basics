{
  "name": "@base/testing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Test harness shared by every vitest suite: Allure/TestOps metadata, integration-service gating, log capture, span capture, Prometheus text parsing. Test-only — never import from runtime code.",
  "files": [
    "dist"
  ],
  "exports": {
    "./log-envelope": {
      "source": "./src/log-envelope.ts",
      "types": "./src/log-envelope.ts",
      "import": "./dist/log-envelope.js"
    },
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint --max-warnings=46 src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean:build": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "allure-js-commons": "3.12.2",
    "pino": "10.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
