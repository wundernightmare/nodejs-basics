{
  "name": "@base/resilience",
  "version": "0.0.1",
  "private": true,
  "description": "Circuit-breaker, retry-policy with exponential jittered backoff, per-tenant DB rate limiter.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/resilient-client": "workspace:*",
    "bottleneck": "2.19.5",
    "opossum": "9.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "11.x",
    "@nestjs/config": "4.x"
  },
  "devDependencies": {
    "@types/opossum": "8.1.9"
  }
}
