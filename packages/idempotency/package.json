{
  "name": "@base/idempotency",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS interceptor + decorator for at-most-once HTTP semantics via the Idempotency-Key header. Pluggable KV store.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/cache": "workspace:*",
    "@base/logger": "workspace:*",
    "iovalkey": "0.4.0",
    "rxjs": "7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": "12.x",
    "@nestjs/config": "12.x",
    "fastify": "5.x"
  }
}
