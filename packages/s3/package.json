{
  "name": "@base/s3",
  "version": "0.0.1",
  "private": true,
  "description": "Object-storage client: the AWS SDK with env-driven config, a deadline on every call, a readiness check, per-operation metrics and tracing, bounded reads and streaming multipart uploads.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint --max-warnings=0 src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean:build": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@base/common": "workspace:*",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@base/testing": "workspace:*"
  }
}
