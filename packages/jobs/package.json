{
  "name": "@base/jobs",
  "version": "0.0.1",
  "private": true,
  "description": "BullMQ NestJS module: configurable named queues, OTel metrics, BullBoard dashboard wiring.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint --max-warnings=0 src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean:build": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/cache": "workspace:*",
    "@base/config": "workspace:*",
    "@base/database": "workspace:*",
    "@base/logger": "workspace:*",
    "@bull-board/api": "9.10.1",
    "@bull-board/fastify": "9.10.1",
    "@opentelemetry/api": "1.9.1",
    "bullmq": "6.3.8",
    "pg": "8.23.0",
    "pg-boss": "12.35.0"
  },
  "peerDependencies": {
    "@nestjs/common": "12.x",
    "@nestjs/config": "12.x",
    "@nestjs/platform-fastify": "12.x"
  },
  "devDependencies": {
    "@base/testing": "workspace:*",
    "@types/pg": "8.23.1"
  }
}
