{
  "name": "@base/jobs",
  "version": "0.0.1",
  "private": true,
  "description": "BullMQ NestJS module: configurable named queues, OTel metrics, BullBoard dashboard wiring.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/cache": "workspace:*",
    "@bull-board/api": "9.6.0",
    "@bull-board/fastify": "9.6.0",
    "@opentelemetry/api": "1.9.1",
    "bullmq": "6.3.2"
  },
  "peerDependencies": {
    "@nestjs/common": "12.x",
    "@nestjs/config": "12.x",
    "@nestjs/platform-fastify": "12.x"
  }
}
