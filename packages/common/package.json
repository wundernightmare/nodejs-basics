{
  "name": "@base/common",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-cutting NestJS primitives: request context (ALS), nanoid, RFC 9457 problem-details, UnitOfWork port.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "nanoid": "5.1.9"
  },
  "peerDependencies": {
    "@nestjs/common": "11.x",
    "@opentelemetry/api": "1.x",
    "fastify": "5.x"
  }
}
