{
  "name": "@base/observability",
  "version": "0.0.1",
  "private": true,
  "description": "OpenTelemetry SDK setup, Sentry, Pyroscope, Node/HTTP/DB metrics, heap snapshot + crash report services, admin server (/metrics, /livez, /readyz, /admin/log-level, /debug/heapdump, /debug/report).",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1032.0",
    "@base/cache": "workspace:*",
    "@base/database": "workspace:*",
    "@base/logger": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.7.0",
    "@opentelemetry/exporter-prometheus": "0.215.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.215.0",
    "@opentelemetry/instrumentation": "0.215.0",
    "@opentelemetry/resources": "2.7.0",
    "@opentelemetry/sdk-metrics": "2.7.0",
    "@opentelemetry/sdk-trace-base": "2.7.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@pyroscope/nodejs": "0.4.11",
    "@sentry/nestjs": "10.49.0",
    "iovalkey": "0.3.3",
    "pg": "8.20.0"
  },
  "peerDependencies": {
    "@nestjs/common": "11.x",
    "fastify": "5.x"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
