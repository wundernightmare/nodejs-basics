{
  "name": "@base/resilient-client",
  "version": "0.0.1",
  "private": true,
  "description": "Portable resilient HTTP client (undici + opossum + bottleneck) plus optional Node.js OTel metrics.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./node-metrics": {
      "source": "./src/node-metrics.ts",
      "types": "./src/node-metrics.ts",
      "import": "./dist/node-metrics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage reports .stryker-tmp"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "bottleneck": "2.19.5",
    "opossum": "9.0.0",
    "undici": "8.1.0"
  },
  "peerDependencies": {
    "@opentelemetry/sdk-metrics": "2.6.0"
  },
  "devDependencies": {
    "@types/opossum": "8.1.9"
  }
}
