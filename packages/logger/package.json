{
  "name": "@base/logger",
  "version": "0.0.1",
  "private": true,
  "description": "Pino logger configured for ECS, OpenTelemetry trace correlation, and AsyncLocalStorage request context.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/common": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "pino": "10.3.1"
  },
  "peerDependencies": {
    "@nestjs/common": "12.x"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3"
  }
}
