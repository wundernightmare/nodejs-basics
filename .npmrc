# pnpm / npm config. pnpm's own settings (overrides, allowBuilds, the
# supply-chain policy) live in pnpm-workspace.yaml — pnpm 11+ no longer reads
# them from package.json.

# Supply chain: a version published less than 7 days ago does not resolve
# (npm >= 11.10 honours this here; pnpm reads minimumReleaseAge from
# pnpm-workspace.yaml — keep the two in step).
min-release-age=7

# Closed network: point pnpm at the internal npm mirror (corepack needs
# COREPACK_NPM_REGISTRY as well — see .env.example).
#registry=https://npm.internal
