{
  "name": "@base/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reference NestJS application that wires every @base/* module together. Boots against docker/deps.yml.",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "node ../../scripts/dev.mjs --admin-port=9091",
    "start:debug": "node ../../scripts/dev.mjs --admin-port=9091 --inspect",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=31 src vite.config.ts",
    "lint:fix": "oxlint --fix src vite.config.ts",
    "format": "oxfmt \"src/**/*.ts\" vite.config.ts",
    "format:check": "oxfmt --check \"src/**/*.ts\" vite.config.ts",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@base/cache": "workspace:*",
    "@base/common": "workspace:*",
    "@base/config": "workspace:*",
    "@base/contracts": "workspace:*",
    "@base/database": "workspace:*",
    "@base/idempotency": "workspace:*",
    "@base/jobs": "workspace:*",
    "@base/kafka": "workspace:*",
    "@base/logger": "workspace:*",
    "@base/observability": "workspace:*",
    "@base/outbox": "workspace:*",
    "@base/resilience": "workspace:*",
    "@base/resilient-client": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/otel": "0.21.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "fastify": "5.12.5",
    "iovalkey": "0.4.0",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@base/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
