{
  "name": "@base/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reference NestJS application that wires every @base/* module together. Boots against docker/deps.yml.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "NODE_OPTIONS='--conditions source --import tsx/esm' nest start --watch",
    "start:debug": "NODE_OPTIONS='--conditions source --import tsx/esm' nest start --debug --watch",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "tsc --build --clean && rm -rf dist coverage"
  },
  "dependencies": {
    "@base/cache": "workspace:*",
    "@base/common": "workspace:*",
    "@base/config": "workspace:*",
    "@base/database": "workspace:*",
    "@base/idempotency": "workspace:*",
    "@base/jobs": "workspace:*",
    "@base/kafka": "workspace:*",
    "@base/logger": "workspace:*",
    "@base/observability": "workspace:*",
    "@base/resilience": "workspace:*",
    "@base/resilient-client": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/otel": "0.20.1",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.76.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.67.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "fastify": "5.8.5",
    "iovalkey": "0.4.0",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@types/pg": "8.20.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.11"
  }
}
