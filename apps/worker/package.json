{
  "name": "@base/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kafka consumer worker: drains tasks.events, enqueues a BullMQ job, processes it.",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "NODE_OPTIONS='--conditions source --import tsx/esm' node src/main.ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@base/config": "workspace:*",
    "@base/jobs": "workspace:*",
    "@base/kafka": "workspace:*",
    "@base/logger": "workspace:*",
    "@base/observability": "workspace:*",
    "@confluentinc/kafka-javascript": "1.9.0",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-nestjs-core": "0.61.0",
    "@opentelemetry/instrumentation-undici": "0.25.0",
    "bullmq": "5.74.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
