{
  "name": "@base/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Kafka consumer worker: drains tasks.events, enqueues a BullMQ job, processes it.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "node ../../scripts/dev.mjs --admin-port=9093",
    "start:debug": "node ../../scripts/dev.mjs --admin-port=9093 --inspect",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --max-warnings=3 src vite.config.ts",
    "lint:fix": "oxlint --fix src vite.config.ts",
    "format": "oxfmt \"src/**/*.ts\" vite.config.ts",
    "format:check": "oxfmt --check \"src/**/*.ts\" vite.config.ts",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@base/config": "workspace:*",
    "@base/contracts": "workspace:*",
    "@base/jobs": "workspace:*",
    "@base/kafka": "workspace:*",
    "@base/logger": "workspace:*",
    "@base/observability": "workspace:*",
    "@confluentinc/kafka-javascript": "1.10.1",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "bullmq": "6.3.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@base/testing": "workspace:*",
    "@types/node": "26.6.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
