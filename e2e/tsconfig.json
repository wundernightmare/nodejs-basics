{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@base/contracts": [
        "../packages/contracts/src/index.ts"
      ],
      "@base/observability/metrics-registry": [
        "../packages/observability/src/metrics.registry.ts"
      ],
      "@base/logger/log-events": [
        "../packages/logger/src/log-events.ts"
      ],
      "@base/testing/log-envelope": [
        "../packages/testing/src/log-envelope.ts"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
