{
  "name": "@base/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for nodejs-basics (Playwright, API tests \u2014 no browser). Runs against the running stack (just stack-up).",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt \"**/*.ts\"",
    "format:check": "oxfmt --check \"**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "rm -rf playwright-report test-results"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "oxlint": "1.80.0",
    "typescript": "6.0.3"
  }
}
