{
  "name": "@base/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for nodejs-basics (Playwright, API tests — no browser). Runs against the running stack (just stack-up).",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=26 .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt \"**/*.ts\"",
    "format:check": "oxfmt --check \"**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "clean": "rm -rf playwright-report test-results allure-results .e2e-state.json",
    "test:smoke": "playwright test --grep @smoke"
  },
  "devDependencies": {
    "@base/contracts": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "allure-js-commons": "3.12.2",
    "allure-playwright": "3.12.2",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  }
}
